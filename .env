# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@192.168.0.52:5433/postgres

# Shopify
SHOPIFY_STORE_DOMAIN=mythic-vault-2.myshopify.com
SHOPIFY_ACCESS_TOKEN=${{ secrets.SHOPIFY_API_KEY }}
